# docker compose 실행에 필요한 환경변수 템플릿
#
#   cp .env.example .env
#
# .env 는 .gitignore 대상이다. 실제 값을 이 파일에 적지 말 것.
# 저장소가 public 이므로 커밋되는 순간 즉시 노출된다.

# ---- 데이터베이스 ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=camstudy

# 애플리케이션이 사용하는 계정. root 와 반드시 다른 값으로.
DB_USER=camuser
DB_PASSWORD=

# MySQL root 계정. 애플리케이션은 이 값을 쓰지 않는다.
DB_ROOT_PASSWORD=

# ---- JWT ----
# HS256 서명 키. jjwt 가 이 문자열을 Base64 로 디코딩하므로
# "Base64 로 디코딩했을 때 32바이트 이상"이어야 한다.
# 평문 패스프레이즈를 넣으면 실제 키 길이가 의도와 달라진다.
#
#   생성: openssl rand -base64 48
JWT_SECRET=
